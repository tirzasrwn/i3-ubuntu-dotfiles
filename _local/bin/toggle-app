#!/bin/bash

set -euo pipefail

if [[ $# -eq 0 ]]; then
	echo "Usage: $0 <application_name>"
	exit 1
fi

APP_NAME="$1"
PATTERN="/${APP_NAME}( |$)"

if pgrep -x "$APP_NAME" >/dev/null 2>&1 || pgrep -f "$PATTERN" >/dev/null 2>&1; then
	pkill -x "$APP_NAME" 2>/dev/null || pkill -f "$PATTERN" 2>/dev/null || true
	echo "Killed $APP_NAME"
else
	"$APP_NAME" >/dev/null 2>&1 &
	echo "Started $APP_NAME"
fi
