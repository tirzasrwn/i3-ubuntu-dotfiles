#!/usr/bin/env bash

if [[ $# -eq 1 ]]; then
	selected=$1
else
	current_session=$(tmux list-sessions 2>/dev/null | awk -F':' '{print $1}')
	directories=()
	if [[ -f "$HOME/.directory_list" ]]; then
		while IFS= read -r dir; do
			if [[ -z "$dir" || "$dir" == \#* ]]; then
				continue
			fi
			directories+=("${dir/#\~/$HOME}")
		done <"$HOME/.directory_list"
	fi
	directory_list=""
	if (( ${#directories[@]} > 0 )); then
		directory_list=$(find "${directories[@]}" -mindepth 0 -maxdepth 1 -type d 2>/dev/null)
	fi
	if [[ -n "$current_session" ]]; then
		input="$current_session"$'\n'"$directory_list"
	else
		input="$directory_list"
	fi
	selected=$(printf "%s" "$input" | fzf --exact --bind=enter:replace-query+print-query --prompt="tmux-sessionizer: " --preview "eza --icons --tree --level=1 {} 2>&- || tmux list-windows -t {}")
fi

if [[ -z "$selected" ]]; then
	exit 0
fi

selected_name=$(basename "$selected" | tr . _)
tmux_running=$(pgrep -x tmux)

if [[ -z "${TMUX:-}" ]] && [[ -z "$tmux_running" ]]; then
	tmux new-session -s "$selected_name" -c "$selected"
	exit 0
fi

if ! tmux has-session -t="$selected_name" 2>/dev/null; then
	tmux new-session -ds "$selected_name" -c "$selected"
fi

if [[ -n "${TMUX:-}" ]]; then
	tmux switch-client -t "$selected_name"
	exit 0
fi

tmux attach -t "$selected_name"
