#!/bin/bash

set -uo pipefail

THRESHOLD=30
CHECK_INTERVAL=300
NOTIFIED=0

while true; do
	if ! command -v acpi >/dev/null 2>&1; then
		sleep "$CHECK_INTERVAL"
		continue
	fi

	BATTERY_LEVEL=$(acpi -b 2>/dev/null | grep -oP '\d+(?=%)' | awk '{sum += $1; n++} END {if (n) printf "%d", sum / n}')
	IS_CHARGING=$(acpi -b 2>/dev/null | grep -c 'Charging' || true)

	if [[ -n "$BATTERY_LEVEL" ]] && (( BATTERY_LEVEL < THRESHOLD )) && (( IS_CHARGING == 0 )); then
		if (( NOTIFIED == 0 )); then
			notify-send -u critical "Battery Low" "Battery level is ${BATTERY_LEVEL}%. Please plug in your charger." >/dev/null 2>&1 || true
			"$HOME/.local/bin/bell" 1 >/dev/null 2>&1 &
			NOTIFIED=1
		fi
	else
		NOTIFIED=0
	fi

	sleep "$CHECK_INTERVAL"
done
