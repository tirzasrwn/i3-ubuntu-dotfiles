#!/bin/bash

set -euo pipefail

SESSION_NAME="note"
COMMAND_TO_RUN="cd ~/vault/tirzasrwn/ && nvim ."

if [[ -z "${TMUX:-}" ]] && ! pgrep -x tmux >/dev/null; then
	tmux new-session -s "$SESSION_NAME" "$COMMAND_TO_RUN"
	exit 0
fi

if ! tmux has-session -t="$SESSION_NAME" 2>/dev/null; then
	tmux new-session -ds "$SESSION_NAME" "$COMMAND_TO_RUN"
fi

tmux switch-client -t "$SESSION_NAME"
