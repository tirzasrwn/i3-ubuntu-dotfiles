#!/bin/bash

set -uo pipefail

NUM_TIMES="${1:-0}"
[[ "$NUM_TIMES" =~ ^[0-9]+$ ]] || NUM_TIMES=0

if [[ "$NUM_TIMES" -eq 0 ]]; then
	printf "bell is ringing indefinitely...\n"
else
	printf "bell is ringing %s times...\n" "$NUM_TIMES"
fi

SOUND="$HOME/bell.mp3"
if [[ ! -f "$SOUND" ]]; then
	SOUND="/usr/share/sounds/freedesktop/stereo/bell.oga"
fi

amixer_args=()
if amixer -c 1 get Master >/dev/null 2>&1; then
	amixer_args=(-c 1)
fi

CURRENT_VOLUME=$(amixer "${amixer_args[@]}" get Master 2>/dev/null | grep -oP '\[\d+%\]' | head -n1 | tr -d '[]' || true)

restore_volume() {
	if [[ -n "$CURRENT_VOLUME" ]]; then
		amixer "${amixer_args[@]}" set Master "$CURRENT_VOLUME" >/dev/null 2>&1 || true
	fi
}

trap 'printf "\nStopping the bell ...\n"; restore_volume; exit 0' INT TERM

amixer "${amixer_args[@]}" set Master 80% >/dev/null 2>&1 || true

if [[ ! -f "$SOUND" ]]; then
	printf '\a'
elif [[ "$NUM_TIMES" -eq 0 ]]; then
	while true; do
		mpv --no-terminal "$SOUND" >/dev/null 2>&1 || true
		sleep 1
	done
else
	for ((i = 1; i <= NUM_TIMES; i++)); do
		mpv --no-terminal "$SOUND" >/dev/null 2>&1 || true
		sleep 1
	done
fi

restore_volume
exit 0
