#!/bin/bash
set -euo pipefail

CONFIG=${XDG_CONFIG_HOME:-$HOME/.config}
THEME_FILE=$CONFIG/theme
THEMES_DIR=$CONFIG/themes
THEME_DATA=${XDG_DATA_HOME:-$HOME/.local/share}/themes
DEFAULT_FLAVOUR=macchiato

usage() {
	echo "usage: ${0##*/} [--set latte|macchiato] [--status]" >&2
	exit 2
}

current_flavour() {
	local flavour
	flavour=$(head -n1 "$THEME_FILE" 2>/dev/null || true)
	case "$flavour" in
	latte | macchiato) printf '%s\n' "$flavour" ;;
	*) printf '%s\n' "$DEFAULT_FLAVOUR" ;;
	esac
}

flavour=$(current_flavour)

case "${1:-}" in
--status)
	[[ $# -eq 1 ]] || usage
	printf '%s\n' "$flavour"
	exit 0
	;;
--set)
	[[ $# -eq 2 ]] || usage
	flavour=$2
	;;
"")
	[[ $flavour == latte ]] && flavour=macchiato || flavour=latte
	;;
*) usage ;;
esac

case "$flavour" in
latte | macchiato) ;;
*)
	echo "unknown flavour: $flavour" >&2
	exit 1
	;;
esac

# Palette fragments are symlinked into place. A missing fragment is skipped so
# a partial checkout still toggles the apps it does have.
while IFS=: read -r fragment target; do
	[[ -n "$fragment" ]] || continue
	source_file=$THEMES_DIR/$flavour/$fragment
	if [[ ! -f "$source_file" ]]; then
		echo "skip: no fragment $source_file" >&2
		continue
	fi
	mkdir -p "$(dirname "$target")"
	ln -sfn "$source_file" "$target"
done <<EOF
polybar.ini:$CONFIG/polybar/colors.ini
rofi.rasi:$CONFIG/rofi/colors.rasi
tmux.conf:$CONFIG/tmux/colors.conf
alacritty.toml:$CONFIG/alacritty/colors.toml
zathura:$CONFIG/zathura/colors
dunstrc:$CONFIG/dunst/dunstrc
screenkey.json:$CONFIG/screenkey.json
zsh-colors.zsh:$CONFIG/zsh/colors.zsh
gtk.ini:$CONFIG/gtk-3.0/settings.ini
gtk.ini:$CONFIG/gtk-4.0/settings.ini
EOF

# polybar does not expand ${colors.x} inside %{F...} tags, so the few inline
# icon colours are swapped in the deployed module files instead.
if [[ -f $THEMES_DIR/$flavour/polybar.ini && -d $CONFIG/polybar/modules ]]; then
	for pair in "#a6da95 #40a02b" "#ed8796 #d20f39" "#91d7e3 #04a5e5" "#cad3f5 #4c4f69" "#c6a0f6 #8839ef"; do
		read -r macchiato_hex latte_hex <<<"$pair"
		for module in "$CONFIG"/polybar/modules/*.ini; do
			if [[ $flavour == latte ]]; then
				sed -i "s/$macchiato_hex/$latte_hex/gI" "$module"
			else
				sed -i "s/$latte_hex/$macchiato_hex/gI" "$module"
			fi
		done
	done
fi

# i3 does not expand variables defined in an included file, so the palette
# block is rewritten in place between its markers.
i3_fragment=$THEMES_DIR/$flavour/i3.conf
i3_config=$CONFIG/i3/config
if [[ -f $i3_fragment && -f $i3_config ]]; then
	if grep -q '^# >>> theme palette' "$i3_config"; then
		tmp=$(mktemp)
		if awk -v src="$i3_fragment" '
			/^# >>> theme palette/ { print; while ((getline line < src) > 0) print line; skip = 1; next }
			/^# <<< theme palette/ { skip = 0 }
			!skip { print }
		' "$i3_config" >"$tmp"; then
			chmod --reference="$i3_config" "$tmp" 2>/dev/null || true
			mv "$tmp" "$i3_config"
		else
			rm -f "$tmp"
		fi
	else
		echo "warn: no theme palette markers in $i3_config" >&2
	fi
fi

# Record the intent before touching anything that can fail, so a failed reload
# cannot leave the state file pointing at the flavour that is not applied.
printf '%s\n' "$flavour" >"$THEME_FILE"

# A running Neovim keeps the config it started with, so push the switch over
# its RPC socket instead of waiting for a restart.
nvim_bg=dark
[[ $flavour == latte ]] && nvim_bg=light
if command -v nvim >/dev/null 2>&1; then
	for sock in "${XDG_RUNTIME_DIR:-/tmp}"/nvim.*; do
		[[ -S $sock ]] || continue
		nvim --server "$sock" --remote-expr \
			"execute('lua vim.o.background=\"$nvim_bg\"')" >/dev/null 2>&1 || true
	done
fi

# From here on everything is best effort: the files are already consistent.
if command -v jq >/dev/null 2>&1 && [[ -f $CONFIG/opencode/tui.json ]]; then
	oc_theme=catppuccin-macchiato
	oc_mode=dark
	if [[ $flavour == latte ]]; then
		oc_theme=catppuccin-latte
		oc_mode=light
	fi
	tmp=$(mktemp)
	if jq --arg t "$oc_theme" '.theme = $t' "$CONFIG/opencode/tui.json" >"$tmp"; then
		mv "$tmp" "$CONFIG/opencode/tui.json"
	else
		rm -f "$tmp"
	fi
	if [[ -f $CONFIG/opencode/cli.json ]]; then
		tmp=$(mktemp)
		if jq --arg n "$oc_theme" --arg m "$oc_mode" '.theme.name = $n | .theme.mode = $m' "$CONFIG/opencode/cli.json" >"$tmp"; then
			mv "$tmp" "$CONFIG/opencode/cli.json"
		else
			rm -f "$tmp"
		fi
	fi
fi

# Zen picks its scheme at startup and reads user.js on every launch, so this
# works even while it is open.
browser_scheme=2
[[ $flavour == latte ]] && browser_scheme=1
for zen_prefs in "$HOME"/.zen/*/prefs.js; do
	[[ -f $zen_prefs ]] || continue
	cat >"$(dirname "$zen_prefs")/user.js" <<EOF
user_pref("zen.view.window.scheme", $browser_scheme);
user_pref("layout.css.prefers-color-scheme.content-override", $browser_scheme);
EOF
done

if command -v gsettings >/dev/null 2>&1; then
	theme_name=$(sed -n 's/^gtk-theme-name=//p' "$THEMES_DIR/$flavour/gtk.ini" 2>/dev/null || true)
	if [[ -n $theme_name && ! -d $THEME_DATA/$theme_name && ! -d $HOME/.themes/$theme_name ]]; then
		case $flavour in
		latte) theme_name=Yaru ;;
		*) theme_name=Yaru-dark ;;
		esac
	fi
	if [[ -n $theme_name ]]; then
		gsettings set org.gnome.desktop.interface gtk-theme "$theme_name" || true
	fi
	if [[ $flavour == latte ]]; then
		gsettings set org.gnome.desktop.interface color-scheme prefer-light || true
	else
		gsettings set org.gnome.desktop.interface color-scheme prefer-dark || true
	fi
	# libadwaita apps (Nautilus, GNOME apps) ignore gtk-theme-name and read the
	# user CSS instead. GTK4 does not watch that file, and Nautilus keeps its
	# process alive after the window closes, so quit it and let the next launch
	# read the new palette.
	gtk4_css=$THEME_DATA/$theme_name/gtk-4.0/gtk.css
	if [[ -n $theme_name && -f $gtk4_css && -d $CONFIG/gtk-4.0 ]]; then
		cp "$gtk4_css" "$CONFIG/gtk-4.0/gtk.css" || true
		if command -v nautilus >/dev/null 2>&1 && pgrep -x nautilus >/dev/null 2>&1; then
			nautilus -q >/dev/null 2>&1 || true
		fi
	fi
fi

if command -v i3-msg >/dev/null 2>&1 && i3-msg -t get_version >/dev/null 2>&1; then
	i3-msg reload >/dev/null || true
fi

if command -v polybar-msg >/dev/null 2>&1 && pgrep -x polybar >/dev/null 2>&1; then
	polybar-msg cmd restart >/dev/null || true
fi

if command -v tmux >/dev/null 2>&1 && tmux ls >/dev/null 2>&1; then
	tmux source-file "$CONFIG/tmux/tmux.conf" >/dev/null || true
fi

if [[ -f $CONFIG/alacritty/alacritty.toml ]]; then
	touch "$CONFIG/alacritty/alacritty.toml"
fi

if pgrep -x dunst >/dev/null 2>&1; then
	pkill -x dunst || true
	for _ in $(seq 1 40); do
		pgrep -x dunst >/dev/null 2>&1 || break
		sleep 0.05
	done
	setsid dunst >/dev/null 2>&1 &
fi

if pgrep -x screenkey >/dev/null 2>&1; then
	pkill -x screenkey || true
	setsid screenkey >/dev/null 2>&1 &
fi

if command -v notify-send >/dev/null 2>&1; then
	case "$flavour" in
	latte) notify-send -a Theme "Theme" "Latte (light)" || true ;;
	macchiato) notify-send -a Theme "Theme" "Macchiato (dark)" || true ;;
	esac
fi

exit 0
