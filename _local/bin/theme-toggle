#!/bin/bash
set -euo pipefail

CONFIG=${XDG_CONFIG_HOME:-$HOME/.config}
THEME_FILE=$CONFIG/theme
THEMES_DIR=$CONFIG/themes
DEFAULT_FLAVOUR=macchiato

usage() {
	echo "usage: ${0##*/} [--set latte|macchiato] [--status]" >&2
	exit 2
}

current_flavour() {
	local flavour
	flavour=$(head -n1 "$THEME_FILE" 2>/dev/null || true)
	case "$flavour" in
	latte | macchiato) printf '%s\n' "$flavour" ;;
	*) printf '%s\n' "$DEFAULT_FLAVOUR" ;;
	esac
}

flavour=$(current_flavour)

case "${1:-}" in
--status)
	printf '%s\n' "$flavour"
	exit 0
	;;
--set)
	[[ $# -eq 2 ]] || usage
	flavour=$2
	;;
"")
	[[ $flavour == latte ]] && flavour=macchiato || flavour=latte
	;;
*) usage ;;
esac

case "$flavour" in
latte | macchiato) ;;
*)
	echo "unknown flavour: $flavour" >&2
	exit 1
	;;
esac

while IFS=: read -r fragment target; do
	[[ -n "$fragment" ]] || continue
	source_file=$THEMES_DIR/$flavour/$fragment
	if [[ ! -f "$source_file" ]]; then
		echo "skip: no fragment $source_file" >&2
		continue
	fi
	mkdir -p "$(dirname "$target")"
	ln -sfn "$source_file" "$target"
done <<EOF
i3.conf:$CONFIG/i3/colors.conf
polybar.ini:$CONFIG/polybar/colors.ini
rofi.rasi:$CONFIG/rofi/colors.rasi
tmux.conf:$CONFIG/tmux/colors.conf
alacritty.toml:$CONFIG/alacritty/colors.toml
zathura:$CONFIG/zathura/colors
dunstrc:$CONFIG/dunst/dunstrc
screenkey.json:$CONFIG/screenkey.json
zsh-colors.zsh:$CONFIG/zsh/colors.zsh
gtk.ini:$CONFIG/gtk-3.0/settings.ini
gtk.ini:$CONFIG/gtk-4.0/settings.ini
EOF

if command -v jq >/dev/null 2>&1 && [[ -f $CONFIG/opencode/tui.json ]]; then
	oc_theme=catppuccin-macchiato
	oc_mode=dark
	if [[ $flavour == latte ]]; then
		oc_theme=catppuccin-latte
		oc_mode=light
	fi
	if [[ -f $CONFIG/opencode/tui.json ]]; then
		tmp=$(mktemp)
		jq --arg t "$oc_theme" '.theme = $t' "$CONFIG/opencode/tui.json" >"$tmp" && mv "$tmp" "$CONFIG/opencode/tui.json"
	fi
	if [[ -f $CONFIG/opencode/cli.json ]]; then
		tmp=$(mktemp)
		jq --arg n "$oc_theme" --arg m "$oc_mode" '.theme.name = $n | .theme.mode = $m' "$CONFIG/opencode/cli.json" >"$tmp" && mv "$tmp" "$CONFIG/opencode/cli.json"
	fi
fi

if command -v gsettings >/dev/null 2>&1; then
	theme_name=$(sed -n 's/^gtk-theme-name=//p' "$THEMES_DIR/$flavour/gtk.ini" 2>/dev/null || true)
	if [[ -n $theme_name && ! -d ${XDG_DATA_HOME:-$HOME/.local/share}/themes/$theme_name ]]; then
		case $flavour in
		latte) theme_name=Yaru ;;
		*) theme_name=Yaru-dark ;;
		esac
	fi
	if [[ -n $theme_name ]]; then
		gsettings set org.gnome.desktop.interface gtk-theme "$theme_name"
	fi
	if [[ $flavour == latte ]]; then
		gsettings set org.gnome.desktop.interface color-scheme prefer-light
	else
		gsettings set org.gnome.desktop.interface color-scheme prefer-dark
	fi
fi

if command -v i3-msg >/dev/null 2>&1 && i3-msg -t get_version >/dev/null 2>&1; then
	i3-msg reload >/dev/null
fi

if command -v polybar-msg >/dev/null 2>&1 && pgrep -x polybar >/dev/null 2>&1; then
	polybar-msg cmd restart >/dev/null || true
fi

if command -v tmux >/dev/null 2>&1 && tmux ls >/dev/null 2>&1; then
	tmux source-file "$CONFIG/tmux/tmux.conf" >/dev/null || true
fi

if [[ -f $CONFIG/alacritty/alacritty.toml ]]; then
	touch "$CONFIG/alacritty/alacritty.toml"
fi

if pgrep -x dunst >/dev/null 2>&1; then
	pkill -x dunst || true
	setsid dunst >/dev/null 2>&1 &
fi

if pgrep -x screenkey >/dev/null 2>&1; then
	pkill -x screenkey || true
	setsid screenkey --no-systray >/dev/null 2>&1 &
fi

printf '%s\n' "$flavour" >"$THEME_FILE"

if command -v notify-send >/dev/null 2>&1; then
	case "$flavour" in
	latte) notify-send -a Theme "Theme" "Latte (light)" ;;
	macchiato) notify-send -a Theme "Theme" "Macchiato (dark)" ;;
	esac
fi
