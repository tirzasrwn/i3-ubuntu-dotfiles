#!/bin/bash

set -uo pipefail

if command -v go >/dev/null 2>&1; then
	echo "> go clean -modcache"
	go clean -modcache || true
	echo "> go clean -cache"
	go clean -cache || true
fi

if command -v npm >/dev/null 2>&1; then
	echo "> npm cache clean --force"
	npm cache clean --force || true
	echo "> npm cache verify"
	npm cache verify || true
fi

if command -v cargo >/dev/null 2>&1; then
	if cargo cache --version >/dev/null 2>&1; then
		echo "> cargo cache -a"
		cargo cache -a || true
	else
		echo "cargo-cache not installed; skipping (cargo install cargo-cache)"
	fi
fi
